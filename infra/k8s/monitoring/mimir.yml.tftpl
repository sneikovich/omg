# конфіг Mimir (монолітний режим, -target=all), рендериться через templatefile() у mimir.tf
# змінні: bucket, region, retention
# ключі звірено з довідником конфігурації grafana/mimir 3.2.2
multitenancy_enabled: false

server:
  http_listen_port: 8080
  grpc_listen_port: 9095
  log_level: warn

usage_stats:
  enabled: false

common:
  storage:
    backend: s3
    s3:
      endpoint: s3.${region}.amazonaws.com
      region: ${region}
      bucket_name: ${bucket}
      # без цього Mimir не бере креденшіали з AWS SDK (Pod Identity віддає їх через
      # AWS_CONTAINER_CREDENTIALS_FULL_URI) - прапорець experimental, дефолт false
      native_aws_auth_enabled: true

# один бакет на все: розводимо префіксами, інакше Mimir відмовляється стартувати з однаковими шляхами
blocks_storage:
  storage_prefix: blocks
  tsdb:
    dir: /data/tsdb
  bucket_store:
    sync_dir: /data/tsdb-sync
alertmanager_storage:
  storage_prefix: alertmanager
ruler_storage:
  storage_prefix: ruler

# одна репліка: кільця тримаємо в пам'яті, memberlist (дефолт) тут нічого не дає
distributor:
  ring:
    kvstore:
      store: inmemory

ingester:
  ring:
    replication_factor: 1
    kvstore:
      store: inmemory

store_gateway:
  sharding_ring:
    replication_factor: 1
    kvstore:
      store: inmemory

compactor:
  data_dir: /data/compactor
  sharding_ring:
    kvstore:
      store: inmemory

limits:
  compactor_blocks_retention_period: ${retention}
